set -euo pipefail

_configure_cli() {
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
    CLI_VERSION="$(sed -n 's/^holoscan-cli\[create\]==//p' "${SCRIPT_DIR}/requirements-cli.txt")"
    if [[ -z "${CLI_VERSION}" ]]; then
        echo "[hsb] requirements-cli.txt must pin holoscan-cli[create]." >&2
        exit 1
    fi

    export HOLOSCAN_CLI_ROOT="${SCRIPT_DIR}"
    export HOLOSCAN_CLI_CMD_NAME="${BASH_SOURCE[0]}"
    export HOLOSCAN_CLI_SEARCH_PATH="applications,operators,tutorials"
    export HOLOSCAN_CLI_PATH_PREFIX="holohub"
    export HOLOSCAN_CLI_REPO_PREFIX="holoscan-sensor-bridge-hub"
    export HOLOSCAN_CLI_WORKSPACE_NAME="holoscan-sensor-bridge-hub"
    export HOLOSCAN_CLI_IN_CONTAINER_CMD="./hsb"
    export HOLOSCAN_CLI_CREATE_TEMPLATE="${HOLOSCAN_CLI_CREATE_TEMPLATE:-applications/template}"
    # The SDK container version is independent of the CLI package version.
    export HOLOSCAN_CLI_BASE_SDK_VERSION="${HOLOSCAN_CLI_BASE_SDK_VERSION:-4.6.0}"
}

_is_container() {
    [[ -f /.dockerenv || -f /run/.containerenv || -f /run/systemd/container ]] ||
        grep -Eq '(docker|containerd|kubepods|podman|buildkit)' /proc/1/cgroup 2>/dev/null
}

_python_tag() {
    "$1" -c '
import sys
if not (3, 11) <= sys.version_info[:2] < (3, 14):
    sys.exit("[hsb] Python 3.11–3.13 is required; set HOLOSCAN_CLI_PYTHON_BIN.")
print(f"py{sys.version_info.major}.{sys.version_info.minor}")
'
}

# Check the exact pin and imports used by both normal commands and creation.
_cli_ready() {
    "$1" -c '
import sys
from importlib.metadata import version
import holoscan_cli.__main__
from cookiecutter.main import cookiecutter
from holoscan_cli.metadata import metadata_validator
sys.exit(version("holoscan-cli") != sys.argv[1])
' "${CLI_VERSION}" 2>/dev/null
}

_select_python() {
    PYTHON_BIN="${HOLOSCAN_CLI_PYTHON_BIN:-${VIRTUAL_ENV:+${VIRTUAL_ENV}/bin/python}}"
    if [[ -n "${PYTHON_BIN}" ]]; then
        return 0
    fi
    unset PYTHONHOME

    # Images provide the CLI and creation dependencies. Reuse them read-only.
    if [[ -z "${HOLOSCAN_CLI_VENV:-}" ]] && _is_container; then
        PYTHON_BIN="python3"
        if _cli_ready "${PYTHON_BIN}"; then
            return 0
        fi
        echo "[hsb] Rebuild this image to install holoscan-cli[create]==${CLI_VERSION}." >&2
        exit 1
    fi

    # Keep host dependencies isolated, with separate environments per Python minor.
    local python_tag cli_cache
    python_tag="$(_python_tag python3)"
    cli_cache="${XDG_CACHE_HOME:-${HOME:?Set HOME or XDG_CACHE_HOME}/.cache}/holoscan-cli"
    CLI_VENV="${HOLOSCAN_CLI_VENV:-${cli_cache}/${CLI_VERSION}/${python_tag}/venv}"
    if [[ "${EUID}" -eq 0 && -n "${SUDO_USER:-}" ]]; then
        echo "[hsb] Run without sudo to keep the host CLI environment user-owned." >&2
        exit 1
    fi
    if [[ ! -x "${CLI_VENV}/bin/python" ]]; then
        if ! python3 -m venv "${CLI_VENV}"; then
            echo "[hsb] Cannot create ${CLI_VENV}; install python3-venv or select an existing Python environment." >&2
            exit 1
        fi
    fi
    PYTHON_BIN="${CLI_VENV}/bin/python"
}

_activate_python() {
    local python_path python_dir
    python_path="$(type -P "${PYTHON_BIN}" || true)"
    if [[ -z "${python_path}" ]]; then
        echo "[hsb] Python interpreter not found: ${PYTHON_BIN}" >&2
        exit 1
    fi
    # Resolve relative paths without following the executable's venv symlink.
    python_dir="$(cd "$(dirname "${python_path}")" && pwd -P)"
    PYTHON_BIN="${python_dir}/$(basename "${python_path}")"
    _python_tag "${PYTHON_BIN}" >/dev/null
    export HOLOSCAN_CLI_PYTHON_BIN="${PYTHON_BIN}"
    export PATH="${python_dir}:${PATH}"
}

_ensure_cli() {
    if _cli_ready "${PYTHON_BIN}"; then
        return 0
    fi
    echo "[hsb] Installing holoscan-cli[create]==${CLI_VERSION} using ${PYTHON_BIN}" >&2
    if ! "${PYTHON_BIN}" -m pip --version >/dev/null 2>&1; then
        "${PYTHON_BIN}" -m ensurepip --upgrade >&2
    fi
    "${PYTHON_BIN}" -m pip install --disable-pip-version-check \
        --extra-index-url https://pypi.nvidia.com --only-binary=:all: \
        -r "${SCRIPT_DIR}/requirements-cli.txt" >&2
    if ! _cli_ready "${PYTHON_BIN}"; then
        echo "[hsb] The installed CLI or its creation dependencies failed verification." >&2
        exit 1
    fi
}

# Keep phases outside conditionals so Bash stops on provisioning failures.
_configure_cli
_select_python
_activate_python
_ensure_cli
exec "${PYTHON_BIN}" -m holoscan_cli "$@"
